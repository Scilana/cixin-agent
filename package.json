{
  "name": "cixin-agent",
  "version": "0.1.0",
  "private": true,
  "description": "CIX board fleet runtime with portable Harmony scheduling policies",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
